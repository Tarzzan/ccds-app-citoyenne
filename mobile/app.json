{
  "expo": {
    "name": "Ma Commune",
    "slug": "ma-commune-guyane",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f4c2a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.netetfix.macommune",
      "infoPlist": {
        "NSCameraUsageDescription": "Ma Commune a besoin d'accéder à votre caméra pour photographier les anomalies à signaler.",
        "NSPhotoLibraryUsageDescription": "Ma Commune a besoin d'accéder à vos photos pour joindre une image à votre signalement.",
        "NSLocationWhenInUseUsageDescription": "Ma Commune utilise votre position pour localiser précisément les anomalies que vous signalez.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "3"
    },
    "android": {
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f4c2a"
      },
      "package": "com.netetfix.macommune",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Ma Commune a besoin d'accéder à votre caméra pour photographier les anomalies."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Ma Commune utilise votre position pour localiser vos signalements."
        }
      ],
      "./plugins/withKotlinVersion.js"
    ],
    "scheme": "macommune",
    "extra": {
      "API_BASE_URL": "https://api.netetfix.com/api",
      "APP_TERRITORY": "Kourou",
      "APP_REGION": "Guyane Française",
      "eas": {
        "projectId": "b3d38760-9ace-47eb-b84f-37419e550824"
      }
    },
    "sdkVersion": "54.0.0",
    "owner": "william.meri",
    "runtimeVersion": "exposdk:54.0.0",
    "updates": {
      "url": "https://u.expo.dev/b3d38760-9ace-47eb-b84f-37419e550824"
    }
  }
}
